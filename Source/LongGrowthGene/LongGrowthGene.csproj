<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LongGrowthGene</AssemblyName>
    <RootNamespace>LongGrowthGene</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>

    <!-- Build straight into the mod's 1.6/Assemblies folder -->
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- RimWorld + Unity reference assemblies (no game DLL path needed) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    <!-- Harmony, referenced only at compile time (the Harmony mod supplies it at runtime) -->
    <PackageReference Include="Lib.Harmony" Version="2.4.1" ExcludeAssets="runtime" />
    <!-- Lets .NET Framework 4.8 projects build on any OS -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    FALLBACK if the Krafs package for 1.6 can't be restored:
    delete the Krafs line above and reference your game's DLLs instead, e.g.

    <ItemGroup>
      <Reference Include="Assembly-CSharp">
        <HintPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="UnityEngine.CoreModule">
        <HintPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
        <Private>False</Private>
      </Reference>
    </ItemGroup>
  -->

</Project>
